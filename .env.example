# Get these from https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# Session name (creates a .session file after first login)
SESSION_NAME=channel_router

# Source channel: @username or numeric id (e.g. -1001234567890)
SOURCE_CHANNEL=@your_source_channel

# Destination forum group: @username or numeric id
# The group MUST have Topics enabled
DEST_GROUP=@your_destination_group

# Optional: only process messages newer than this (ISO date)
# LEAVE EMPTY to process all history
# SINCE_DATE=2024-01-01

# Delay between sends (seconds) to avoid flood limits
SEND_DELAY=1.0

# If true, only print what would be sent (no messages posted)
DRY_RUN=false

# ---------------------------------------------------------------
# Agent platform (app/) — Telegram Bot API
# ---------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace_me
# Human-readable label, or the @username if the channel is public
TELEGRAM_CHANNEL_NAME=thezone
# Numeric id for private channels (-100...). Find it with: python -m app.cli discover-chats
TELEGRAM_CHANNEL_ID=
LOG_LEVEL=INFO
